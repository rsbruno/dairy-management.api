generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Persons {
  id           String         @id @default(cuid())
  keycloakId   String         @unique
  activeFarm   Farms?         @relation("active_farm", fields: [activeFarmId], references: [id])
  activeFarmId String?
  username     String         @unique
  fullName     String         @default("")
  enabled      Boolean        @default(true)
  transaction  Transactions[]
  farms        Farms[]        @relation("farms_to_person")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  farmsId      String?

  @@map("persons")
}

model Farms {
  id                String              @id @default(cuid())
  name              String
  cnpj              String?             @unique
  clientId          String              @unique
  clientSecret      String              @unique
  CostCenter        CostCenter[]
  products          Products[]
  transactions      Transactions[]
  transactionsTypes TransactionsTypes[]
  measurementUnits  MeasurementUnits[]
  activeMembers     Persons[]           @relation("active_farm")
  members           Persons[]           @relation("farms_to_person")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("farms")
}

model CostCenter {
  id               String         @id @default(cuid())
  name             String         @db.VarChar(100)
  description      String?        @db.VarChar(200)
  code             String?        @db.VarChar(20)
  farm             Farms?         @relation(fields: [farmId], references: [id])
  farmId           String?
  transactions     Transactions[]
  childCostCenters CostCenter[]   @relation("parent_cost_center")
  parentId         String?
  parent           CostCenter?    @relation("parent_cost_center", fields: [parentId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("cost_center")
}

model Products {
  id                String           @id @default(cuid())
  name              String           @db.VarChar(100)
  description       String?          @db.VarChar(200)
  farm              Farms            @relation(fields: [farmId], references: [id])
  farmId            String
  transaction       Transactions[]
  measurementUnit   MeasurementUnits @relation(fields: [measurementUnitId], references: [id])
  measurementUnitId String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("products")
}

model Transactions {
  id            String            @id @default(cuid())
  description   String?           @db.VarChar(200)
  quantity      Float
  unitPrice     Float
  product       Products?         @relation(fields: [productId], references: [id])
  productId     String?
  responsible   Persons           @relation(fields: [responsibleId], references: [id])
  responsibleId String
  farm          Farms             @relation(fields: [farmId], references: [id])
  farmId        String
  type          TransactionsTypes @relation(fields: [typeId], references: [id])
  typeId        String
  costCenter    CostCenter        @relation(fields: [costCenterId], references: [id])
  costCenterId  String
  createdAt     DateTime          @default(now())

  @@map("transactions")
}

model TransactionsTypes {
  id           String         @id @default(cuid())
  name         String         @db.VarChar(100)
  code         String         @unique @db.VarChar(20)
  transactions Transactions[]
  farm         Farms?         @relation(fields: [farmId], references: [id])
  farmId       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("transactions_types")
}

model MeasurementUnits {
  id             String     @id @default(cuid())
  name           String
  code           String
  farm           Farms?     @relation(fields: [farmId], references: [id])
  farmId         String?
  baseUnit       String
  conversionRate Float
  products       Products[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("measurement_units")
}
