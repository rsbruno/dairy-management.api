generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Occupations {
  id      String    @id @default(cuid())
  name    String    @unique
  Persons Persons[]

  @@map("occupations")
}

model Persons {
  id            String      @id @default(cuid())
  keycloakId    String      @unique
  username      String      @unique
  occupationId  Occupations @relation(fields: [occupationsId], references: [id])
  occupationsId String
  Tenant        Tenants?    @relation(fields: [tenantId], references: [id])
  tenantId      String?

  @@map("persons")
}

model Tenants {
  id           String    @id @default(cuid())
  clientId     String    @unique
  clientSecret String    @unique
  members      Persons[]

  @@map("tenants")
}
