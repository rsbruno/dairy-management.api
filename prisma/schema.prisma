generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Persons {
  id         String    @id @default(cuid())
  keycloakId String    @unique
  username   String    @unique
  tenants    Tenants[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("persons")
}

model Tenants {
  id           String    @id @default(cuid())
  clientId     String    @unique
  clientSecret String    @unique
  farm         Farms     @relation(fields: [farmsId], references: [id])
  farmsId      String    @unique
  members      Persons[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("tenants")
}

model Farms {
  id        String   @id @default(cuid())
  name      String
  cnpj      String   @unique
  Tenants   Tenants?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("farms")
}
