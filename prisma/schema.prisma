generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Persons {
  id          String         @id @default(cuid())
  keycloakId  String         @unique
  username    String         @unique
  tenants     Tenants[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  Transaction Transactions[]

  @@map("persons")
}

model Tenants {
  id           String    @id @default(cuid())
  clientId     String    @unique
  clientSecret String    @unique
  farm         Farms     @relation(fields: [farmsId], references: [id])
  farmsId      String    @unique
  members      Persons[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("tenants")
}

model Farms {
  id                String              @id @default(cuid())
  name              String
  cnpj              String              @unique
  Tenants           Tenants?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  CostCenter        CostCenter[]
  products          Products[]
  Transactions      Transactions[]
  TransactionsTypes TransactionsTypes[]
  MeasurementUnits  MeasurementUnits[]

  @@map("farms")
}

model CostCenter {
  id          String     @id @default(cuid())
  name        String     @db.VarChar(100)
  description String?    @db.VarChar(200)
  farmId      String
  farm        Farms      @relation(fields: [farmId], references: [id])
  products    Products[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("costCenter")
}

model Products {
  id           String         @id @default(cuid())
  name         String         @db.VarChar(100)
  description  String?        @db.VarChar(200)
  quantity     Float
  unitPrice    Float
  costCenter   CostCenter?    @relation(fields: [costCenterId], references: [id])
  costCenterId String?
  farm         Farms?         @relation(fields: [farmId], references: [id])
  farmId       String?
  Transaction  Transactions[]

  @@map("products")
}

model Transactions {
  id            String            @id @default(cuid())
  description   String?           @db.VarChar(200)
  quantity      Float
  unitPrice     Float
  product       Products          @relation(fields: [productId], references: [id])
  productId     String
  responsible   Persons           @relation(fields: [responsibleId], references: [id])
  responsibleId String
  farm          Farms             @relation(fields: [farmId], references: [id])
  farmId        String
  type          TransactionsTypes @relation(fields: [typeId], references: [id])
  typeId        String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("transactions")
}

model TransactionsTypes {
  id           String         @id @default(cuid())
  name         String         @db.VarChar(100)
  code         String         @unique @db.VarChar(100)
  transactions Transactions[]
  farm         Farms          @relation(fields: [farmId], references: [id])
  farmId       String

  @@map("transactions_types")
}

model MeasurementUnits {
  id             String   @id @default(cuid())
  name           String
  code           String
  farm           Farms?   @relation(fields: [farmId], references: [id])
  farmId         String?
  baseUnit       String
  conversionRate Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("measurement_units")
}
